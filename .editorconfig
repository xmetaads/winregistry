root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml,md}]
indent_size = 2

# .reg files are UTF-16LE with CRLF by specification. Leave them alone.
[*.reg]
charset = utf-16le
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false
